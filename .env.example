# ==================================================
# 🌎 การตั้งค่าทั่วไป (Global Config)
# ใช้ร่วมกันในหลายๆ Service
# ==================================================
TZ=Asia/Bangkok
DOMAIN=local.dev
EMAIL=your-email@yourdomain.com

# ==================================================
# 🐘 ฐานข้อมูลหลัก (PostgreSQL Admin)
# การตั้งค่า Super Admin ของ PostgreSQL (ใช้ตอนสร้าง Container)
# ==================================================
POSTGRES_USER=root
POSTGRES_PASSWORD=rootpassword
POSTGRES_DB=root

# ==================================================
# 🧑‍💻 เครื่องมือจัดการฐานข้อมูล (pgAdmin)
# ข้อมูลสำหรับล็อกอินเข้าหน้าเว็บ pgAdmin
# ==================================================
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=root

# ==================================================
# ⚡️ แคช (Redis)
# ที่อยู่สำหรับเชื่อมต่อ Redis (ตัวนี้อาจใช้สำหรับ Infisical)
# Prefect มีการตั้งค่า Redis แยกของตัวเอง
# ==================================================
REDIS_URL=redis://redis:6379

# ==================================================
# 🔒 บริการ Infisical (Secrets Management)
# ==================================================
# --- กุญแจความปลอดภัยหลัก (สำคัญมาก ห้ามหาย) ---
# (สร้างด้วย: openssl rand -base64 16)
ENCRYPTION_KEY=
# (สร้างด้วย: openssl rand -base64 32)
AUTH_SECRET=

# --- ฐานข้อมูลสำหรับ Infisical ---
# (ตัวแปรเหล่านี้จะถูกใช้โดยสคริปต์ init-user-db.sh เพื่อสร้าง DB)
INFISICAL_POSTGRES_USER=infisical
INFISICAL_POSTGRES_PASSWORD=infisical
INFISICAL_POSTGRES_DB=infisical

# --- Connection String ที่แอป Infisical ใช้ ---
# (แนะนำให้ Infisical ใช้ User ของตัวเอง)
INFISICAL_DB_CONNECTION_URI=postgresql://${INFISICAL_POSTGRES_USER}:${INFISICAL_POSTGRES_PASSWORD}@db:5432/${INFISICAL_POSTGRES_DB}

# ==================================================
# ✈️ บริการ Prefect (Workflow Orchestration)
# ==================================================
# --- ที่อยู่สำหรับหน้าเว็บ (UI) ---
# ที่อยู่เต็มที่ผู้ใช้จะพิมพ์ในเบราว์เซอร์เพื่อเข้าหน้า UI
PREFECT_UI_URL=https://prefect.${DOMAIN}
# ที่อยู่เต็มของ API ที่ UI (จากเบราว์เซอร์) จะต้องเรียกใช้
PREFECT_UI_API_URL=https://prefect.${DOMAIN}/api
# Path ที่ให้บริการ UI ( / หมายถึงที่รากของโดเมน)
PREFECT_UI_SERVE_BASE=/

# --- ฐานข้อมูลสำหรับ Prefect ---
# (ตัวแปรเหล่านี้จะถูกใช้โดยสคริปต์ init-user-db.sh เพื่อสร้าง DB)
PREFECT_POSTGRES_USER=prefect
PREFECT_POSTGRES_PASSWORD=prefect
PREFECT_POSTGRES_DB=prefect

# --- Connection String ที่แอป Prefect ใช้ ---
PREFECT_API_DATABASE_CONNECTION_URL=postgresql+asyncpg://${PREFECT_POSTGRES_USER}:${PREFECT_POSTGRES_PASSWORD}@db:5432/${PREFECT_POSTGRES_DB}
PREFECT_API_DATABASE_MIGRATE_ON_START=false

# --- การตั้งค่า Redis สำหรับ Prefect (ใช้เป็น Broker/Cache) ---
PREFECT_MESSAGING_BROKER=prefect_redis.messaging
PREFECT_MESSAGING_CACHE=prefect_redis.messaging
PREFECT_SERVER_EVENTS_CAUSAL_ORDERING=prefect_redis.ordering
PREFECT_SERVER_CONCURRENCY_LEASE_STORAGE=prefect_redis.lease_storage
PREFECT_REDIS_MESSAGING_HOST=redis
PREFECT_REDIS_MESSAGING_PORT=6379
PREFECT_REDIS_MESSAGING_DB=0

# ==================================================
# 💾 บริการสำรองข้อมูล (Rclone)
# ==================================================
# --- กำหนดการ (Cron Schedule) ---
# (ตัวอย่างนี้คือ รันทุก 15 นาที)
BACKUP_SCHEDULE=*/15 * * * *

# --- ข้อมูลล็อกอินหน้าเว็บ Rclone ---
RCLONE_USER=satang
RCLONE_PASS=123456