# ==================================================
# 🌎 การตั้งค่าทั่วไป (Global Config)
# ==================================================
TZ=Asia/Bangkok
DOMAIN=local.dev
EMAIL=your-email@yourdomain.com

# ==================================================
# ☁️ บริการภายนอก (External APIs)
# ==================================================
CLOUDFLARE_API_TOKEN=

# ==================================================
# 🐘 ฐานข้อมูลหลัก (PostgreSQL Admin)
# ==================================================
POSTGRES_USER=root
POSTGRES_PASSWORD=rootpassword
POSTGRES_DB=root

# ==================================================
# 🧑‍💻 เครื่องมือจัดการฐานข้อมูล (pgAdmin)
# ==================================================
PGADMIN_DEFAULT_EMAIL=admin@admin.com
PGADMIN_DEFAULT_PASSWORD=root

# ==================================================
# ⚡️ แคช (Redis)
# ==================================================
REDIS_URL=redis://redis:6379

# ==================================================
# 💽 บริการ MinIO (S3 Storage)
# ==================================================
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=YOUR_MINIO_SECRET_PASSWORD

# ==================================================
# 🔐 Stack ความปลอดภัย (Security Stack)
# ==================================================

# --- 1. Authelia (Authentication) ---
AUTHELIA_JWT_SECRET=YOUR_VERY_STRONG_JWT_SECRET_HERE
AUTHELIA_SESSION_SECRET=YOUR_VERY_STRONG_SESSION_SECRET_HERE
AUTHELIA_DB_USER=authelia
AUTHELIA_DB_NAME=authelia
AUTHELIA_DB_PASSWORD=YOUR_STRONG_POSTGRES_PASSWORD_HERE

# --- 2. Crowdsec (IPS) ---
CROWDSEC_BOUNCER_API_KEY=YOUR_CROWDSEC_BOUNCER_API_KEY_HERE

# --- 3. Vault (Secrets) ---
VAULT_DOMAIN=vault.${DOMAIN}
VAULT_POSTGRES_USER=vault
VAULT_POSTGRES_PASSWORD=vaultpassword
VAULT_POSTGRES_DB=vault

# ==================================================
# ✈️ บริการ Prefect (Workflow Orchestration)
# ==================================================
# --- ที่อยู่ UI ---
PREFECT_UI_URL=https://prefect.${DOMAIN}
PREFECT_UI_API_URL=https://prefect.${DOMAIN}/api
PREFECT_UI_SERVE_BASE=/

# --- ฐานข้อมูล (Postgres) ---
PREFECT_POSTGRES_USER=prefect
PREFECT_POSTGRES_PASSWORD=prefect
PREFECT_POSTGRES_DB=prefect
PREFECT_API_DATABASE_CONNECTION_URL=postgresql+asyncpg://${PREFECT_POSTGRES_USER}:${PREFECT_POSTGRES_PASSWORD}@db:5432/${PREFECT_POSTGRES_DB}
PREFECT_API_DATABASE_MIGRATE_ON_START=false

# --- การตั้งค่า Redis (Broker) ---
PREFECT_MESSAGING_BROKER=prefect_redis.messaging
PREFECT_MESSAGING_CACHE=prefect_redis.messaging
PREFECT_SERVER_EVENTS_CAUSAL_ORDERING=prefect_redis.ordering
PREFECT_SERVER_CONCURRENCY_LEASE_STORAGE=prefect_redis.lease_storage
PREFECT_REDIS_MESSAGING_HOST=redis
PREFECT_REDIS_MESSAGING_PORT=6379
PREFECT_REDIS_MESSAGING_DB=0

# ==================================================
# 🧪 บริการ MLflow (ML Experiment Tracking)
# ==================================================
MLFLOW_VERSION=latest
MLFLOW_HOST=0.0.0.0
MLFLOW_PORT=5000
AWS_DEFAULT_REGION=us-east-1

# --- ฐานข้อมูล (Postgres) ---
MLFLOW_POSTGRES_USER=mlflow
MLFLOW_POSTGRES_PASSWORD=YOUR_MLFLOW_DB_SECRET_PASSWORD
MLFLOW_POSTGRES_DB=mlflow
MLFLOW_BACKEND_STORE_URI="postgresql://${MLFLOW_POSTGRES_USER}:${MLFLOW_POSTGRES_PASSWORD}@postgres-db:5432/${MLFLOW_POSTGRES_DB}"

# --- ที่เก็บ Artifacts (Minio) ---
MLFLOW_S3_ENDPOINT_URL="http://minio:9000"
MLFLOW_DEFAULT_ARTIFACT_ROOT="s3://mlflow"

# ==================================================
# 💾 บริการสำรองข้อมูล (Backup)
# ==================================================
BACKUP_SCHEDULE=*/15 * * * *