# ==============================================================================
# PROJECT satangthevalue: การตั้งค่าสำหรับสภาพแวดล้อมการพัฒนาบนเครื่อง Local
# ==============================================================================

# -- การตั้งค่าทั่วไป
COMPOSE_PROJECT_NAME=satangthevalue
DOMAIN=localhost

# -- ข้อมูลการเข้าถึงฐานข้อมูล PostgreSQL
# ใช้โดย PostgreSQL, MLflow, Prefect, และเซอร์วิสของแอปพลิเคชัน
POSTGRES_DB=satangthevalue_db
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_PORT=5432

# -- ข้อมูลการเข้าถึง S3 Storage ของ MinIO
# ใช้โดย MinIO, MLflow, และ Label Studio
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin
MINIO_DEFAULT_BUCKETS=satangthevalue-data
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001

# -- การตั้งค่า Jenkins
JENKINS_ADMIN_USER=admin
JENKINS_ADMIN_PASSWORD=password

# -- การตั้งค่าแอปพลิเคชัน
# URL สำหรับให้ Frontend เชื่อมต่อไปยัง API ของ Backend
NEXT_PUBLIC_API_URL=https://api.localhost

# -- การตั้งค่า Observability
# ชื่อเซอร์วิสสำหรับ Tracing
OTEL_SERVICE_NAME=satangthevalue-platform

# -- ข้อมูลการเข้าถึงฐานข้อมูล PostgreSQL (สำหรับ Vault โดยเฉพาะ)
# แยกผู้ใช้และฐานข้อมูลเพื่อความปลอดภัย
VAULT_POSTGRES_DB=vault_db
VAULT_POSTGRES_USER=vaultuser
VAULT_POSTGRES_PASSWORD=vaultpassword