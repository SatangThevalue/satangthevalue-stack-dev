# ==================================================
# 🌎 GLOBAL SETTINGS (ค่าพื้นฐานที่ใช้ร่วมกัน)
# ==================================================
TZ=Asia/Bangkok
DOMAIN=satangthevalue.dev
EMAIL=satangthevalue@gmail.com

# --- Master Credentials (รหัสผ่านหลัก) ---
# แนะนำให้ใช้ user/pass นี้กับทุก service ที่ต้องการสิทธิ์ root เพื่อจำง่าย
USER_ALL_ROOT=admin
PASSWORD_ALL_ROOT=StrongPassword123!

# --- SMTP (Email Service) ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=${EMAIL}
SMTP_PASSWORD=

# --- External APIs ---
CLOUDFLARE_API_TOKEN=

# ==================================================
# 🏗️ DATA INFRASTRUCTURE (ฐานข้อมูลและระบบจัดเก็บ)
# ==================================================

# --- 🐘 PostgreSQL (Main Database) ---
POSTGRES_HOST=postgres-db
POSTGRES_PORT=5432
POSTGRES_USER=root
POSTGRES_PASSWORD=${PASSWORD_ALL_ROOT}
POSTGRES_DB=root

# --- ⚡️ Redis (Cache & Broker) ---
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}

# --- 💽 MinIO (S3 Object Storage) ---
MINIO_HOST=minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=${USER_ALL_ROOT}
MINIO_ROOT_PASSWORD=${PASSWORD_ALL_ROOT}

# ==================================================
# 🚀 APPLICATIONS & SERVICES (แยกรายแอป)
# ==================================================

# --- 🌐 Nginx Proxy Manager (Gateway) ---
NPM_DB_POSTGRES_HOST=${POSTGRES_HOST}
NPM_DB_POSTGRES_PORT=${POSTGRES_PORT}
NPM_DB_POSTGRES_USER=${POSTGRES_USER}
NPM_DB_POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
NPM_DB_POSTGRES_NAME=npm_db
NPM_INITIAL_ADMIN_EMAIL=${EMAIL}
NPM_INITIAL_ADMIN_PASSWORD=${PASSWORD_ALL_ROOT}

# --- 🔐 HashiCorp Vault (Secrets Management) ---
VAULT_DOMAIN=vault.${DOMAIN}
VAULT_POSTGRES_USER=${POSTGRES_USER}
VAULT_POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
VAULT_POSTGRES_DB=vault

# --- ✈️ Prefect (Workflow Orchestration) ---
# UI & API
PREFECT_UI_URL=https://prefect.${DOMAIN}
PREFECT_UI_API_URL=https://prefect.${DOMAIN}/api
PREFECT_UI_SERVE_BASE=/
# Database
PREFECT_POSTGRES_USER=${POSTGRES_USER}
PREFECT_POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
PREFECT_POSTGRES_DB=prefect
PREFECT_API_DATABASE_CONNECTION_URL=postgresql+asyncpg://${PREFECT_POSTGRES_USER}:${PREFECT_POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${PREFECT_POSTGRES_DB}
PREFECT_API_DATABASE_MIGRATE_ON_START=false
# Redis Configuration
PREFECT_REDIS_MESSAGING_HOST=${REDIS_HOST}
PREFECT_REDIS_MESSAGING_PORT=${REDIS_PORT}
PREFECT_REDIS_MESSAGING_DB=0
PREFECT_MESSAGING_BROKER=prefect_redis.messaging
PREFECT_MESSAGING_CACHE=prefect_redis.messaging
PREFECT_SERVER_EVENTS_CAUSAL_ORDERING=prefect_redis.ordering
PREFECT_SERVER_CONCURRENCY_LEASE_STORAGE=prefect_redis.lease_storage

# --- 🧪 MLflow (Experiment Tracking) ---
MLFLOW_VERSION=latest
MLFLOW_HOST=0.0.0.0
MLFLOW_PORT=5000
AWS_DEFAULT_REGION=us-east-1
# Database
MLFLOW_POSTGRES_USER=${POSTGRES_USER}
MLFLOW_POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
MLFLOW_POSTGRES_DB=mlflow
MLFLOW_BACKEND_STORE_URI="postgresql://${MLFLOW_POSTGRES_USER}:${MLFLOW_POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${MLFLOW_POSTGRES_DB}"
# Artifacts (MinIO)
MLFLOW_S3_ENDPOINT_URL="http://${MINIO_HOST}:${MINIO_PORT}"
MLFLOW_DEFAULT_ARTIFACT_ROOT="s3://mlflow"

# --- 🤖 n8n (Workflow Automation) ---
# สำคัญ: ต้องใส่ค่า N8N_ENCRYPTION_KEY เพื่อความปลอดภัย
N8N_ENCRYPTION_KEY=
N8N_GENERIC_TIMEZONE=${TZ}
N8N_POSTGRES_USER=${POSTGRES_USER}
N8N_POSTGRES_PASSWORD=${POSTGRES_PASSWORD}
N8N_POSTGRES_DB=n8n_db

# --- 🧑‍💻 pgAdmin (Database Manager) ---
PGADMIN_DEFAULT_EMAIL=${EMAIL}
PGADMIN_DEFAULT_PASSWORD=${PASSWORD_ALL_ROOT}

# --- 💾 Backup Utilities ---
BACKUP_SCHEDULE=*/15 * * * *
LOKI_DB_NAME=loki
LOKI_DB_USER=${POSTGRES_USER}
LOKI_DB_PASSWORD=${POSTGRES_PASSWORD}